# Скопировать в .env и заполнить для production
SECRET_KEY=stellar-drift-dev-secret-CHANGE-IN-PROD
DATABASE_URL=sqlite:///./stellar_drift.db

# PostgreSQL (prod):
# DATABASE_URL=postgresql://user:password@localhost/stellar_drift

# USDT (TRC-20) приём платежей — см. crypto_payments.py.
# CRYPTO_WALLET_SEED — BIP39-мнемоника, мастер-ключ ко ВСЕМ депозитным адресам.
# На mainnet — сгенерировать НОВУЮ фразу, никогда не касавшуюся тестовых
# потоков, и хранить ТОЛЬКО как env-переменную на проде (никогда в git/чате).
CRYPTO_WALLET_SEED=
# shasta (тестнет) | mainnet (реальные деньги)
CRYPTO_NETWORK=shasta
# На mainnet НЕ нужен — берётся из _MAINNET_USDT_CONTRACT в crypto_payments.py.
# На shasta — обязателен, официального USDT-контракта там нет.
CRYPTO_USDT_CONTRACT=
# Опционально — повышает rate-limit TronGrid API (без ключа тоже работает).
TRON_API_KEY=
